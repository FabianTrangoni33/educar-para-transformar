# Puerto del servidor Express
PORT=3000

# Cadena de conexión PostgreSQL (obtenida de Neon.tech o Supabase)
# Ejemplo Neon: postgresql://usuario:password@ep-ejemplo-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://usuario:password@localhost:5432/educar_para_transformar

# Clave secreta para la firma de tokens JWT
JWT_SECRET=super_secret_tup_frre_metodologia_2026

# ── Correo (recordatorios de cuota y avisos de deuda) ──
# Si SMTP_HOST queda vacío los correos NO salen: se registran como SIMULADO (útil para pruebas).
# Ejemplo Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=cuenta@gmail.com, SMTP_PASS=<contraseña de aplicación>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Educar para Transformar <no-reply@educarparatransformar.edu.ar>"
# Durante las pruebas, redirige TODOS los correos a esta casilla (no molesta a familias reales)
MAIL_PRUEBA=

# ── Tarea diaria (Vercel Cron llama a /api/cron/diario con este secreto) ──
CRON_SECRET=cambiar_por_un_valor_largo_y_aleatorio
