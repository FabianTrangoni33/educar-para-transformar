{
  "expo": {
    "name": "Educar para Transformar",
    "slug": "educar-para-transformar",
    "scheme": "educarparatransformar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ar.edu.educarparatransformar.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Usamos Face ID para desbloquear la app de forma segura."
      }
    },
    "android": {
      "package": "ar.edu.educarparatransformar.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Usamos Face ID para desbloquear la app de forma segura."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1f4e79"
        }
      ],
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Usamos la cámara para escanear códigos QR (ingreso con QR y credenciales de alumnos).",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "e490defb-5afd-4144-abdb-85f938c8212e"
      }
    }
  }
}
