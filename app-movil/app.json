{
  "expo": {
    "name": "Educar para Transformar",
    "slug": "educar-para-transformar",
    "scheme": "educarparatransformar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ar.edu.educarparatransformar.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Usamos Face ID para desbloquear la app de forma segura."
      }
    },
    "android": {
      "package": "ar.edu.educarparatransformar.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Usamos Face ID para desbloquear la app de forma segura."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1f4e79"
        }
      ],
      "expo-font"
    ]
  }
}
